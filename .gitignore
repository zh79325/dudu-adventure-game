# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
[Rr]ecordings/

# Memory Profiler Snapshots
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Coverage
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Unity-MCP 插件自动还原的 NuGet 依赖（18 MB 二进制）
# 版本清单记在 Assets/Plugins/NuGet/.nuget-installed.json，插件的
# DependencyResolver 会照它从 api.nuget.org 重新拉，不需要进版本库
# 注意必须带 **/ 前缀：中间含斜杠的模式会被锚定到本文件所在目录，
# 否则只匹配仓库根的 Assets/，匹配不到 DuduAdventure/Assets/
**/[Aa]ssets/Plugins/NuGet/
**/[Aa]ssets/Plugins/NuGet.meta

# 编辑器本地配置（Unity 自动生成）
.vscode/

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Plastic SCM
*.ignore
*.orig

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/

# Scratch screenshots from unity-mcp verification loop
DuduAdventure/_shots/
weapon_verify/
